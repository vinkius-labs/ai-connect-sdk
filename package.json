{
  "name": "@vinkius/connect",
  "version": "0.1.3",
  "description": "Ship AI features, not integration projects. Give every user of your AI app their own connectors and AI capabilities.",
  "license": "Apache-2.0",
  "author": "Vinkius",
  "homepage": "https://github.com/vinkius-labs/ai-connect-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinkius-labs/ai-connect-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/vinkius-labs/ai-connect-sdk/issues"
  },
  "keywords": [
    "vinkius",
    "connectors",
    "capabilities",
    "ai",
    "agents",
    "tools",
    "tool-calling",
    "function-calling",
    "llm",
    "mcp",
    "openai",
    "anthropic",
    "gemini",
    "langchain",
    "llamaindex",
    "ai-sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./openai": {
      "types": "./dist/adapters/openai.d.ts",
      "import": "./dist/adapters/openai.js",
      "require": "./dist/adapters/openai.cjs"
    },
    "./anthropic": {
      "types": "./dist/adapters/anthropic.d.ts",
      "import": "./dist/adapters/anthropic.js",
      "require": "./dist/adapters/anthropic.cjs"
    },
    "./ai-sdk": {
      "types": "./dist/adapters/ai-sdk.d.ts",
      "import": "./dist/adapters/ai-sdk.js",
      "require": "./dist/adapters/ai-sdk.cjs"
    },
    "./gemini": {
      "types": "./dist/adapters/gemini.d.ts",
      "import": "./dist/adapters/gemini.js",
      "require": "./dist/adapters/gemini.cjs"
    },
    "./langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "import": "./dist/adapters/langchain.js",
      "require": "./dist/adapters/langchain.cjs"
    },
    "./json-schema": {
      "types": "./dist/adapters/json-schema.d.ts",
      "import": "./dist/adapters/json-schema.js",
      "require": "./dist/adapters/json-schema.cjs"
    },
    "./openai-agents": {
      "types": "./dist/adapters/openai-agents.d.ts",
      "import": "./dist/adapters/openai-agents.js",
      "require": "./dist/adapters/openai-agents.cjs"
    },
    "./llamaindex": {
      "types": "./dist/adapters/llamaindex.d.ts",
      "import": "./dist/adapters/llamaindex.js",
      "require": "./dist/adapters/llamaindex.cjs"
    },
    "./workers-ai": {
      "types": "./dist/adapters/workers-ai.d.ts",
      "import": "./dist/adapters/workers-ai.js",
      "require": "./dist/adapters/workers-ai.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^2.1.2",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.2"
  }
}
